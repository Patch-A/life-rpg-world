# 模型服务（OpenAI 兼容）
# 必填：你的 API Key。不要提交真实值。
AI_API_KEY=
# 模型名。留空则用调用方默认值（记录官 deepseek-chat、行动助手 deepseek-flash）。
# 用非 DeepSeek 端点时必须填本地模型名（如 qwen3、llama3.1），否则会拿 deepseek 的模型名去请求而报错。
AI_MODEL=
# 端点地址。留空默认 https://api.deepseek.com；非 DeepSeek 才需要改，例如 Ollama 的 http://localhost:11434/v1。
# base URL 需要包含 /v1（DeepSeek 例外，它的根路径本身就是完整前缀）。
AI_BASE_URL=

# 旧名，仅兼容已有部署；同时配置时上面的 AI_* 优先。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# ---- 运维开关（留空即用代码默认值，通常无需修改）----
# 总开关：留空或 true 为启用；填 false 关闭全部模型调用，手动记录不受影响。
AI_ENABLED=
# 行动助手每用户每日次数。默认 10；想放宽或收紧额度时再改。
AI_USER_DAILY_LIMIT=
# 行动助手全站每日次数。默认 100；用于控制总成本。
AI_SITE_DAILY_LIMIT=
# 记录官聊天每用户每日次数。默认 50；比行动助手宽松，因为聊天轮次更密。
AI_CHAT_USER_DAILY_LIMIT=
# 记录官聊天全站每日次数。默认 500；用于控制总成本。
AI_CHAT_SITE_DAILY_LIMIT=
